# Copy to .env and fill in. Never commit .env.

# The image docker compose runs. The Deploy workflow publishes it to the GitHub Container
# Registry; leave the line out to build the image from the source instead.
# RC_IMAGE=ghcr.io/<owner>/<repository>:latest

# Password of the PostgreSQL database that docker compose starts next to the app.
POSTGRES_PASSWORD=

# Without docker compose, point the API at your own PostgreSQL 14 or newer instead:
# RC_DATABASE_URL=postgres://rychta:password@localhost:5432/rychta
# RC_DATABASE_SSL=true

# Public address of the site, used in e-mails and for the allowed browser origin.
RC_PUBLIC_URL=https://www.rychtacenkovice.cz
RC_ALLOWED_ORIGINS=https://www.rychtacenkovice.cz

# Signing key of the access tokens. At least 32 random characters, for example:
#   openssl rand -base64 48
RC_JWT_SECRET=

# The first administrator. Created on the first start if no administrator exists yet.
# The password must have at least 12 characters. Remove both lines afterwards.
RC_ADMIN_EMAIL=
RC_ADMIN_PASSWORD=

# Set to true when a reverse proxy in front of the app sets X-Forwarded-For.
RC_TRUST_PROXY=true

# E-mail. Without RC_SMTP_HOST nothing is sent; messages are saved in RC_OUTBOX_DIR instead.
RC_MAIL_FROM=Rychta Čenkovice <rezervace@rychtacenkovice.cz>
RC_MAIL_TO=rychtacenkovice@seznam.cz
RC_SMTP_HOST=
RC_SMTP_PORT=587
RC_SMTP_USERNAME=
RC_SMTP_PASSWORD=
# starttls | tls | none
RC_SMTP_TLS=starttls

# Session lifetimes (defaults shown).
# RC_ACCESS_TTL=10m
# RC_REFRESH_TTL=7d
# RC_SESSION_TTL=30d

# hCaptcha on the booking request and the contact form. Create a site at
# https://dashboard.hcaptcha.com, copy the site key and the account secret here.
# With both empty the forms work without a captcha (rate limit and honeypot only).
RC_HCAPTCHA_SITEKEY=
RC_HCAPTCHA_SECRET=
